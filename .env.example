# Connexion PostgreSQL utilisée par l'ETL (etl/database.py) et par l'API (api/db.py).
# Ces valeurs correspondent à l'instance locale définie dans docker-compose.yml.
# Copier ce fichier en `.env` : `cp .env.example .env`
PG_USER=postgres
PG_PWD=postgres
PG_DB=ipolitics
PG_HOST=localhost
PG_PORT=5432

# Mettre à True pour logguer toutes les requêtes SQL émises par SQLAlchemy.
PG_ECHO=False

DUCKDB_PATH=./data/vectors.duckdb
# `false` nécessaire pendant la génération des embeddings
DUCKDB_READ_ONLY=False
# Laisser vide pour attribution automatique
DUCKDB_THREADS=

# --- Application (api/ + web/) ---
# Interface et port d'écoute d'uvicorn (`just serve`). Le même processus sert les
# pages HTML sur / et l'API JSON sur /api.
API_HOST=127.0.0.1
API_PORT=8000
# Origines autorisées en CORS, séparées par des virgules. L'interface étant servie
# par ce même processus, elle est de même origine et n'a pas besoin de CORS :
# ceci ne concerne que les consommateurs tiers de l'API JSON.
API_ALLOWED_ORIGINS=
# Nombre de connexions Postgres gardées ouvertes par l'API.
API_POOL_SIZE=10
