{% import "macros/ui.html.j2" as ui %}
{#
  Barre de contrôle de l'explorateur : recherche, facettes actives, facettes
  disponibles, tri.

  Ce bloc vit HORS de `#amendement-results`, la cible d'échange des listes : sans
  précaution, un clic sur une facette remplaçait le tableau et laissait la barre
  inchangée — les pastilles ne suivaient donc jamais l'état réel. Il est donc
  rendu ici avec un `id` propre et ré-émis en swap « out of band » par
  `partials/amendement_swap.html.j2`, si bien que la barre et le tableau bougent
  du même échange.

  `oob` n'est vrai que pour cette réponse HTMX : au chargement complet, le bloc
  est rendu en place et ne doit pas porter `hx-swap-oob`, sous peine de se
  remplacer lui-même.
#}
<div id="amendement-controls"{% if oob %} hx-swap-oob="true"{% endif %}>
  {#
    Barre de progression du panneau. Elle est hors de `#amendement-results` pour
    rester lisible pendant que le tableau, lui, est estompé par `.htmx-request`.
  #}
  <div id="amendement-progress" class="dw-progress" aria-hidden="true"></div>

  <div style="padding:20px 32px;border-bottom:2px solid var(--color-divider)">
    {#
      Recherche et facettes sont un formulaire GET : les champs cachés rejouent
      les facettes actives, si bien qu'une recherche conserve les filtres au lieu
      de les effacer. Ils sont dans ce bloc pour être rafraîchis avec le reste.
    #}
    <form
      action="{{ path }}" method="get"
      hx-get="{{ path }}"
      hx-target="#amendement-results" hx-push-url="true"
    >
      {% if params.withMentions %}<input type="hidden" name="withMentions" value="true">{% endif %}
      {% if params.article %}<input type="hidden" name="article" value="{{ params.article }}">{% endif %}
      {% if params.groupe %}<input type="hidden" name="groupe" value="{{ params.groupe }}">{% endif %}
      {% if params.sort_filter %}<input type="hidden" name="sort_filter" value="{{ params.sort_filter }}">{% endif %}
      <input type="hidden" name="sort" value="{{ params.sort }}">
      <div style="display:flex;border:2px solid var(--color-text);background:var(--color-bg)">
        <div style="flex:1;display:flex;align-items:center;gap:10px;padding:10px 14px">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--color-neutral-600);flex:none">
            <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
          </svg>
          <input
            type="text" name="q" value="{{ params.q }}"
            placeholder="Rechercher dans les amendements…"
            style="flex:1;border:none;outline:none;background:transparent;font-size:15px;color:var(--color-text)"
          >
        </div>
        <button type="submit" class="btn btn-primary" style="border-radius:0;padding:0 22px">Chercher</button>
      </div>
    </form>

    <div style="display:flex;gap:12px;margin-top:12px;flex-wrap:wrap;align-items:center">
      {# Facettes actives : un clic retire le filtre. #}
      {% if chips %}
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
          {% for chip in chips %}
            <a class="tag {{ 'tag-accent' if chip.accent else 'tag-neutral' }}"
               href="{{ chip.remove_url }}"
               hx-get="{{ chip.remove_url }}" hx-target="#amendement-results" hx-push-url="true"
               title="Retirer : {{ chip.title | default(chip.label, true) }}"
               style="cursor:pointer;text-decoration:none{% if not chip.accent %};border:1px solid var(--color-divider){% endif %}"
            >{{ chip.label }} ✕</a>
          {% endfor %}
        </div>
      {% endif %}

      {#
        Facettes disponibles. `openFilter` n'ouvre qu'un menu à la fois et
        `pending` marque l'option cliquée : la fermeture et le marquage sont
        immédiats, sans attendre l'aller-retour réseau.
      #}
      <div
        style="display:flex;gap:6px;flex-wrap:wrap;align-items:center"
        x-data="{ openFilter: null, pending: null }"
        @keydown.escape="openFilter = null"
      >
        {% set menus = [
          ('article',     'Article', 'article',     facets.articles),
          ('groupe',      'Groupe',  'groupe',      facets.groupes),
          ('sort_filter', 'Sort',    'sort_filter', facets.sorts)
        ] %}
        {% for key, label, param, values in menus %}
          {% if not params[param] and values %}
            <div style="position:relative">
              <button
                type="button"
                class="tag tag-neutral dw-facet-add"
                @click="openFilter = openFilter === '{{ key }}' ? null : '{{ key }}'"
                :aria-expanded="openFilter === '{{ key }}' ? 'true' : 'false'"
              >+ {{ label }}</button>
              <div class="dw-menu" x-show="openFilter === '{{ key }}'" x-cloak @click.outside="openFilter = null">
                {% for value in values %}
                  {% set add_url = build_url(path, params, page=none, **{param: value}) %}
                  <a
                    href="{{ add_url }}"
                    title="{{ value }}"
                    hx-get="{{ add_url }}" hx-target="#amendement-results" hx-push-url="true"
                    @click="pending = '{{ loop.index }}'; openFilter = null"
                    :class="pending === '{{ loop.index }}' && 'is-pending'"
                  >{{ value }}</a>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}

        {#
          Mentions externes : facette booléenne, donc un bouton d'ajout plutôt
          qu'un menu. Une fois active, elle n'apparaît plus ici mais en pastille.
        #}
        {% if not params.withMentions %}
          {% set add_url = build_url(path, params, withMentions=true, page=none) %}
          <a class="tag tag-neutral dw-facet-add" href="{{ add_url }}"
             hx-get="{{ add_url }}" hx-target="#amendement-results" hx-push-url="true"
             style="text-decoration:none"
          >+ mentions externes</a>
        {% endif %}
      </div>

      <span style="margin-left:auto;display:flex;gap:6px;align-items:center;font-size:12px;color:var(--color-neutral-700)">
        Trier par
        {{ ui.seg_control('sort', params.sort, SORT_OPTIONS, '#amendement-results', build_url(path, params, sort=none, page=none)) }}
      </span>
    </div>
  </div>
</div>
