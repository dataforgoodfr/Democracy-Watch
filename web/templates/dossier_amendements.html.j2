{% extends "base.html.j2" %}
{% import "macros/ui.html.j2" as ui %}
{% set nav_section = 'dossiers' %}

{% block title %}Amendements — {{ dossier.titre | truncate_words(10) }}{% endblock %}

{#
  Ancienne mise en page `explorer` : pas de barre de navigation, une colonne
  latérale à gauche. Ici le bloc `nav` est vidé et la colonne fait partie du
  contenu, car elle est à gauche et non à droite comme celle de `base`.
#}
{% block nav %}{% endblock %}

{% block content %}
<div style="display:grid;grid-template-columns:260px minmax(0,1fr);min-height:100vh">
  <!-- Colonne latérale : dossier ouvert + historique -->
  <div
    x-data="dwHistory()"
    style="background:var(--color-surface);border-right:2px solid var(--color-divider);padding:20px 18px;display:flex;flex-direction:column;gap:18px"
  >
    <a href="/" style="font:800 15px/1 var(--font-heading);text-decoration:none;color:inherit">DEMOCRACY WATCH</a>
    <hr class="hr" style="margin:0">
    <div>
      <h6 style="margin-bottom:12px">Dossier ouvert</h6>
      <div style="font:600 12px/1.35 var(--font-body)">{{ dossier.titre }}</div>
      <div style="font:11px ui-monospace,monospace;color:var(--color-neutral-600);margin-top:4px">{{ dossier.uid }}</div>
      <a href="/dossiers/{{ dossier.uid }}" class="btn btn-ghost" style="padding-left:0;margin-top:8px;text-decoration:none">← Fiche du dossier</a>
    </div>
    <hr class="hr" style="margin:0">
    <div style="flex:1">
      <div style="display:flex;justify-content:space-between;align-items:baseline">
        <h6 style="margin:0">Historique</h6>
        <span style="font-size:10px;color:var(--color-neutral-600)"><span x-text="recent.length">0</span> vus</span>
      </div>
      <div x-show="!recent.length" style="font-size:11px;color:var(--color-neutral-600);margin-top:12px">
        Ouvrez un amendement pour le retrouver ici.
      </div>
      <div style="display:grid;gap:2px;margin-top:12px">
        <template x-for="e in recent.slice(0, 8)" :key="e.uid">
          <a :href="`/amendements/${e.uid}`" style="padding:8px 10px;background:var(--color-bg);text-decoration:none;color:inherit;display:block">
            <div style="font:600 12px ui-monospace,monospace" x-text="e.numeroLong"></div>
            <div style="font-size:11px;color:var(--color-neutral-700)" x-text="`${e.article} · ${e.groupeAbbrev} · ${e.sort}`"></div>
          </a>
        </template>
      </div>
    </div>
    <button class="btn btn-secondary btn-block" :disabled="!entries.length" @click="clear()">Vider l'historique</button>
  </div>

  <!-- Colonne principale -->
  <div style="min-width:0">
    {% include "partials/amendement_controls.html.j2" %}
    {% include "partials/amendement_results.html.j2" %}
  </div>
</div>
{% endblock %}
