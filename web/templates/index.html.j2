{% extends "base.html.j2" %}
{% import "macros/ui.html.j2" as ui %}
{% set nav_section = 'dossiers' %}

{% block title %}Democracy Watch — dossiers de la 17ᵉ législature{% endblock %}

{% block content %}
  <!-- Bandeau -->
  <div style="padding:56px 64px 40px;border-bottom:2px solid var(--color-divider)">
    <div style="display:grid;grid-template-columns:1fr 380px;gap:64px;align-items:end">
      <div>
        <div style="font:600 11px/1 var(--font-body);letter-spacing:.14em;text-transform:uppercase;color:var(--color-accent);margin-bottom:14px">
          Assemblée nationale · 17ᵉ législature
        </div>
        <h1 style="font-size:58px;max-width:14em;text-wrap:balance">Voir qui écrit la loi, et avec qui.</h1>
        <p style="max-width:46em;font-size:16px;color:var(--color-neutral-700)">
          Chaque amendement déposé, son auteur, son sort, et les collaborations extérieures que son exposé sommaire déclare. Données publiques, méthode ouverte.
        </p>
      </div>

      {% call ui.divider_grid(cols='1fr 1fr', border=true) %}
        {{ ui.stat_cell(stats.dossier_count | fr_number, 'dossiers', size=30) }}
        {{ ui.stat_cell(stats.amendment_count | fr_number, 'amendements', size=30) }}
        {{ ui.stat_cell(stats.mention_count | fr_number, 'mentions de collaboration', accent=true, size=30) }}
        {{ ui.stat_cell(stats.scrutin_count | fr_number, 'scrutins publics', size=30) }}
      {% endcall %}
    </div>
  </div>

  <!-- Recherche -->
  <div style="padding:32px 64px 48px">
    {#
      La recherche est un vrai formulaire GET : sans JavaScript elle recharge la
      page avec les bons paramètres, et HTMX ne fait qu'intercepter l'envoi pour
      ne remplacer que le bloc de résultats.
    #}
    <form
      action="/" method="get"
      hx-get="/" hx-target="#dossier-results" hx-push-url="true"
    >
      {% if params.withMentions %}<input type="hidden" name="withMentions" value="true">{% endif %}
      <div style="display:flex;gap:0;border:2px solid var(--color-text);background:var(--color-bg)">
        <div style="flex:1;display:flex;align-items:center;gap:12px;padding:0 18px">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--color-neutral-600);flex:none">
            <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
          </svg>
          <input
            type="text" name="q" value="{{ params.q }}"
            placeholder="Rechercher un dossier…"
            style="flex:1;border:none;outline:none;background:transparent;font-size:16px;padding:18px 0;color:var(--color-text)"
          >
        </div>
        <button type="submit" class="btn btn-primary" style="padding:0 28px;border-radius:0">Rechercher</button>
      </div>
    </form>

    <!-- Filtres -->
    <div style="display:flex;gap:8px;margin-top:14px;align-items:center;flex-wrap:wrap">
      <span class="micro-label" style="margin-right:4px">Filtres</span>
      {% for chip in chips %}
        <a class="tag tag-accent" href="{{ chip.remove_url }}"
           hx-get="{{ chip.remove_url }}" hx-target="#dossier-results" hx-push-url="true"
           style="cursor:pointer;text-decoration:none">{{ chip.label }} ✕</a>
      {% endfor %}
      {% if not params.withMentions %}
        {% set add_url = build_url('/', params, withMentions=true, page=none) %}
        <a class="tag tag-neutral" href="{{ add_url }}"
           hx-get="{{ add_url }}" hx-target="#dossier-results" hx-push-url="true"
           style="border:1px dashed var(--color-divider);color:var(--color-neutral-600);cursor:pointer;text-decoration:none">+ mentions externes</a>
      {% endif %}
      <span style="margin-left:auto;font-size:12px;color:var(--color-neutral-600)">
        Recherche sur le titre du dossier
      </span>
    </div>

    <hr class="hr" style="margin:28px 0 0">

    {% include "partials/dossier_results.html.j2" %}
  </div>
{% endblock %}
