{#
  Graphiques : hémicycle, flux de mentions, histogramme des dépôts. Chacun est une
  fonction pure de ses données, donc rendu en SVG inline sans une ligne de
  JavaScript. Les infobulles passent par `<title>`, natif en SVG, plutôt que par un
  état de survol côté client.
#}

{% macro hemicycle(groupes_votants) -%}
{#
  Un siège = un député, à sa place réelle. Le vote n'étant connu qu'en agrégat par
  groupe, la couleur d'un siège donné n'indique pas le vote de son occupant ; le
  placement est fait par `web/hemicycle.py`, pas ici.
#}
<svg
  viewBox="0 0 {{ SEAT_VIEWBOX.width }} {{ SEAT_VIEWBOX.height }}"
  width="100%" height="292" style="display:block"
>
  {% for seat in seats_for(groupes_votants) %}
    <circle cx="{{ seat.x }}" cy="{{ seat.y }}" r="1.55" fill="{{ seat.fill }}"><title>{{ seat.tooltip }}</title></circle>
  {% endfor %}
</svg>
{%- endmacro %}


{% macro mentions_flow(groups, sources, links) -%}
{#
  Les bandes viennent de `compute_bands()`, la même fonction que les colonnes de
  libellés de la page appellent : les deux ne peuvent donc pas se désynchroniser.
  Le viewBox de 420 doit rester égal à la largeur du conteneur côté page, sinon
  les rubans s'étirent hors des libellés qu'ils annotent.
#}
{% set group_pos = compute_bands(groups) %}
{% set source_pos = compute_bands(sources) %}
<svg viewBox="0 0 420 340" width="420" height="340" style="display:block;overflow:visible">
  {% for ribbon in compute_ribbons(groups, sources, links) %}
    <path
      d="{{ ribbon.d }}"
      fill="{{ '#ec3013' if ribbon.highlight else '#201e1d' }}"
      opacity="{{ ribbon.opacity }}"
    ><title>{{ ribbon.tooltip }}</title></path>
  {% endfor %}

  {% for g in groups %}
    {% set band = group_pos[g.key] %}
    <rect x="0" y="{{ band.y }}" width="10" height="{{ band.h }}" fill="#201e1d" />
  {% endfor %}

  {% for s in sources %}
    {% set band = source_pos[s.key] %}
    <rect
      x="410" y="{{ band.y }}" width="10" height="{{ band.h }}"
      fill="{{ '#ec3013' if is_highlighted(s.typeEntite) else '#201e1d' }}"
    />
  {% endfor %}
</svg>
{%- endmacro %}


{% macro deposit_histogram(histogram) -%}
<div>
  <h6>Dépôts d'amendements dans le temps</h6>

  {% if not histogram %}
    <div style="font-size:12px;color:var(--color-neutral-600);margin-top:14px">
      Aucune date de dépôt renseignée pour ce dossier.
    </div>
  {% else %}
    {% set h = histogram_bars(histogram) %}
    <div style="display:flex;align-items:flex-end;gap:3px;height:120px;margin-top:18px">
      {% for bar in h.bars %}
        <span
          style="flex:1;min-height:2px;height:{{ bar.pct }}%;background:{{ bar.color }}"
          title="{{ bar.label }}"
        ></span>
      {% endfor %}
    </div>
    <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--color-neutral-600);margin-top:6px">
      {% for label in h.axis %}<span>{{ label }}</span>{% endfor %}
    </div>
    {#
      La légende ne décrit que ce qui est réellement rendu. Elle annonçait avant des
      couleurs « séance publique » et « pic de mentions externes » pilotées par des
      champs que l'API n'envoie pas, si bien que toutes les barres étaient grises.
    #}
    <div style="display:flex;gap:16px;font-size:11px;color:var(--color-neutral-700);margin-top:12px">
      <span style="display:flex;gap:6px;align-items:center">
        <span style="width:10px;height:10px;background:var(--color-neutral-400)"></span>
        amendements déposés par semaine
      </span>
      <span style="display:flex;gap:6px;align-items:center">
        <span style="width:10px;height:10px;background:var(--color-accent)"></span>
        semaine la plus active ({{ h.peak.cnt }} le {{ h.peak.week | fr_week }})
      </span>
    </div>
  {% endif %}
</div>
{%- endmacro %}


{% macro legislative_path(steps) -%}
{#
  Parcours reconstitué depuis les actes de la procédure (voir `web/legislative.py`).

  La frise est verticale et non horizontale : le nombre d'étapes est variable (deux
  pour une lecture unique, dix pour la loi « fin de vie » — deux lectures par
  chambre, CMP, nouvelle lecture, lecture définitive, Conseil constitutionnel) et
  une rangée à largeur fixe tronquait tout au-delà de cinq. La colonne s'allonge,
  elle, sans limite.
#}
{% if steps %}
<div>
  <h6>Parcours du texte</h6>
  <div style="position:relative;margin-top:20px;padding-left:26px">
    {# Filet vertical reliant les pastilles : arrêté à la dernière, sinon il
       dépasse sous l'étape courante. #}
    <div style="position:absolute;left:7px;top:8px;bottom:14px;width:2px;background:var(--color-divider)"></div>
    {% for step in steps %}
      <div style="position:relative;padding:0 0 18px">
        <span style="position:absolute;left:-26px;top:4px;width:16px;height:16px;display:block;background:{{ 'var(--color-accent)' if step.state == 'current' else 'var(--color-text)' }}{% if step.state == 'current' %};outline:4px solid var(--color-accent-200){% endif %}"></span>
        <div style="font:800 14px/1.3 var(--font-heading)">{{ step.label }}</div>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:4px">
          {% if step.date %}
            <span style="font-size:12px;color:{{ 'var(--color-accent-700)' if step.state == 'current' else 'var(--color-neutral-700)' }}">{{ step.date | fr_long_date }}</span>
          {% endif %}
          {% if step.outcome_label %}
            {# `detail` porte le libellé source complet (« adoptée, dans les
               conditions prévues à l'article 45, alinéa 3… »), trop long pour la
               pastille mais utile au survol. #}
            <span class="tag {{ outcome_tag_class(step.outcome) }}" {% if step.detail %}title="{{ step.detail }}"{% endif %}>{{ step.outcome_label }}</span>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>
{% endif %}
{%- endmacro %}


{% macro group_bars(rows) -%}
{# Barres « mentions par groupe » de la fiche dossier. #}
<div style="display:grid;gap:10px;margin-top:20px">
  {% for row in mentions_by_group_rows(rows) %}
    <div style="display:grid;grid-template-columns:78px 1fr 28px;gap:10px;align-items:center">
      <span style="font:600 12px var(--font-body)">{{ row.group_abbrev }}</span>
      <span style="height:14px;background:var(--color-bg)">
        <span style="display:block;height:14px;width:{{ row.pct }}%;background:{{ 'var(--color-accent)' if row.accent else 'var(--color-text)' }}"></span>
      </span>
      <span style="font:600 12px ui-monospace,monospace;text-align:right">{{ row.cnt }}</span>
    </div>
  {% endfor %}
</div>
{%- endmacro %}
